{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "dev:watch": "NODE_ENV=development tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:vercel": "vite build && esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --sourcemap=inline --outfile=api/_app.mjs",
    "start": "node dist/server.cjs",
    "icons": "node scripts/generate-icons.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/adjudicator.test.mjs && tsx tests/offlineQueue.test.mjs && tsx tests/serverGuards.test.mjs && tsx tests/i18n.test.mjs && tsx tests/timelapse.test.mjs",
    "test:db": "tsx tests/db/migrations.test.mjs && tsx tests/db/creditIntegrity.test.mjs && tsx tests/db/households.test.mjs && tsx tests/db/privacy.test.mjs && tsx tests/db/moderation.test.mjs && tsx tests/db/reviewFixes.test.mjs && tsx tests/db/advisors.test.mjs && tsx tests/db/rateLimits.test.mjs",
    "test:api": "tsx tests/api/api.test.mjs",
    "test:all": "npm test && npm run test:db && npm run test:api",
    "test:auth": "npm run build && node scripts/auth-smoke.mjs",
    "link-worker": "node scripts/link-worker.mjs",
    "ops:purge-evidence": "tsx scripts/purge-evidence.ts",
    "ops:check-ledger": "tsx scripts/check-ledger.ts",
    "ops:notify-settled": "tsx scripts/notify-settled.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.13",
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/themes": "^2.4.57",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
