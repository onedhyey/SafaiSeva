# Copy to .env and fill in. .env is gitignored. Never put real secrets in THIS file —
# it is committed, and the server does not read values from it.

# ── AI vision check (Google AI Studio) ────────────────────────────────────────
# Required for the verification endpoints. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional override. Must be a real, currently-supported model id.
GEMINI_MODEL="gemini-3.6-flash"
# Optional: send Gemini calls through a proxy / regional endpoint.
GEMINI_BASE_URL=""

# ── Authentication ───────────────────────────────────────────────────────────
# Leave false (or unset) for the open public demo: no sign-in, anonymous device session.
# Set to true to require Clerk auth. This is BUILD-TIME (VITE_*) — rebuild/redeploy the
# client after changing it; the server reads the same var at process start.
# Full flip procedure and manual test checklist: docs/AUTH.md
VITE_AUTH_ENABLED="false"
# Demo identity (anonymous device sessions + demo karmachari/officer headers) is only
# accepted when NODE_ENV=development (npm run dev sets it) or when this is "true".
# Leave unset in production: with auth off and this unset, the API answers 503.
# Set "true" only for a separate public demo deployment with no real rewards.
ALLOW_DEMO_IDENTITY=""
# Where the sign-in gateway sits when auth is enabled:
#   before_role = sign in, then choose resident/karmachari/officer  (default)
#   after_role  = choose role, then sign in
VITE_AUTH_GATE="before_role"
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional hardening: comma-separated origins allowed to mint the session tokens the API
# accepts (defaults to APP_URL). Leave unset to skip the authorized-party check.
CLERK_AUTHORIZED_PARTIES=""

# ── Supabase backend (Phase 1) ──────────────────────────────────────────────
# Project URL + keys from the Supabase dashboard → Project Settings → API.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Exposed to the browser client (safe: anon key + RLS). Mirror of the two above.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ── Misc ────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (self-referential links, QR token issuer).
APP_URL=""
# Secret used to HMAC-sign redeemable QR tokens. Any long random string. REQUIRED outside
# development: without it ticket redemption answers 503 (before any credits are spent).
QR_SIGNING_SECRET=""

# Behind a platform proxy / load balancer, its hop count (usually 1). Unset = trust none.
TRUST_PROXY=""

# ── Privacy (audit F8) ──────────────────────────────────────────────────────
# Days evidence photos/videos are kept before `npm run ops:purge-evidence` deletes them.
EVIDENCE_RETENTION_DAYS="90"

# ── Web Push ────────────────────────────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push services can reach: mailto:you@example.org or https://your-site
VAPID_SUBJECT=""
# Window for `npm run ops:notify-settled`; match the job's schedule (minutes).
SETTLED_WINDOW_MINUTES="60"

# ── Pilot ───────────────────────────────────────────────────────────────────
# Ward code new households are created in.
PILOT_WARD_CODE="W12-NAVRANGPURA"

# ── Vercel ──────────────────────────────────────────────────────────────────
# Secret Vercel Cron sends as `Authorization: Bearer …` to /api/cron/daily.
CRON_SECRET=""
